<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/eqContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/profile_title"
            android:textColor="@color/on_background"
            android:textSize="28sp" />

        <Spinner
            android:id="@+id/templateSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="48dp"
            android:popupBackground="@color/background" />

        <TextView
            android:id="@+id/profileDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/on_background_muted"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/saveTemplateButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/template_save" />

            <Button
                android:id="@+id/deleteTemplateButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/template_delete" />
        </LinearLayout>

        <Button
            android:id="@+id/restoreTemplateButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/template_restore" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/gate_title"
            android:textColor="@color/on_background"
            android:textSize="20sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/gateSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/gate_enable"
            android:textColor="@color/on_background"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/gate_hint"
            android:textColor="@color/on_background_muted"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="112dp"
                android:layout_height="wrap_content"
                android:text="@string/gate_threshold"
                android:textColor="@color/on_background"
                android:textSize="16sp" />

            <SeekBar
                android:id="@+id/gateThresholdSeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="36" />

            <TextView
                android:id="@+id/gateThresholdValue"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@color/on_background"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="112dp"
                android:layout_height="wrap_content"
                android:text="@string/gate_depth"
                android:textColor="@color/on_background"
                android:textSize="16sp" />

            <SeekBar
                android:id="@+id/gateDepthSeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="30" />

            <TextView
                android:id="@+id/gateDepthValue"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@color/on_background"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="112dp"
                android:layout_height="wrap_content"
                android:text="@string/gate_attack"
                android:textColor="@color/on_background"
                android:textSize="16sp" />

            <SeekBar
                android:id="@+id/gateAttackSeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="49" />

            <TextView
                android:id="@+id/gateAttackValue"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@color/on_background"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="112dp"
                android:layout_height="wrap_content"
                android:text="@string/gate_hold"
                android:textColor="@color/on_background"
                android:textSize="16sp" />

            <SeekBar
                android:id="@+id/gateHoldSeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="40" />

            <TextView
                android:id="@+id/gateHoldValue"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@color/on_background"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="112dp"
                android:layout_height="wrap_content"
                android:text="@string/gate_release"
                android:textColor="@color/on_background"
                android:textSize="16sp" />

            <SeekBar
                android:id="@+id/gateReleaseSeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="59" />

            <TextView
                android:id="@+id/gateReleaseValue"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@color/on_background"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/eq_parametric"
            android:textColor="@color/on_background"
            android:textSize="20sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/eq_parametric_hint"
            android:textColor="@color/on_background_muted"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/toneBands"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/lowering_title"
            android:textColor="@color/on_background"
            android:textSize="20sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/loweringSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/lowering_enable"
            android:textColor="@color/on_background"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/lowering_hint"
            android:textColor="@color/on_background_muted"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/powerNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/lowering_paused"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/compressionButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/mic_button_bg"
                android:minHeight="48dp"
                android:text="@string/lowering_compression"
                android:textColor="@color/mic_button_text" />

            <Button
                android:id="@+id/shiftButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/mic_button_bg"
                android:minHeight="48dp"
                android:text="@string/lowering_shift"
                android:textColor="@color/mic_button_text" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="112dp"
                android:layout_height="wrap_content"
                android:text="@string/lowering_cutoff"
                android:textColor="@color/on_background"
                android:textSize="16sp" />

            <SeekBar
                android:id="@+id/cutoffSeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="48" />

            <TextView
                android:id="@+id/cutoffValue"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@color/on_background"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/amountLabel"
                android:layout_width="112dp"
                android:layout_height="wrap_content"
                android:text="@string/lowering_ratio"
                android:textColor="@color/on_background"
                android:textSize="16sp" />

            <SeekBar
                android:id="@+id/amountSeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/amountValue"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@color/on_background"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="112dp"
                android:layout_height="wrap_content"
                android:text="@string/lowering_mix"
                android:textColor="@color/on_background"
                android:textSize="16sp" />

            <SeekBar
                android:id="@+id/mixSeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100" />

            <TextView
                android:id="@+id/mixValue"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@color/on_background"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/adaptive_title"
            android:textColor="@color/on_background"
            android:textSize="20sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/adaptiveSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/adaptive_enable"
            android:textColor="@color/on_background"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/adaptive_hint"
            android:textColor="@color/on_background_muted"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/adaptivePowerNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/lowering_paused"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="112dp"
                android:layout_height="wrap_content"
                android:text="@string/adaptive_strength"
                android:textColor="@color/on_background"
                android:textSize="16sp" />

            <SeekBar
                android:id="@+id/strengthSeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="10" />

            <TextView
                android:id="@+id/strengthValue"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@color/on_background"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="112dp"
                android:layout_height="wrap_content"
                android:text="@string/adaptive_caution"
                android:textColor="@color/on_background"
                android:textSize="16sp" />

            <SeekBar
                android:id="@+id/cautionSeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100" />

            <TextView
                android:id="@+id/cautionValue"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@color/on_background"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/eq_graphic"
            android:textColor="@color/on_background"
            android:textSize="20sp" />

        <LinearLayout
            android:id="@+id/graphicBands"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/clarity_title"
            android:textColor="@color/on_background"
            android:textSize="20sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/claritySwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/clarity_enable"
            android:textColor="@color/on_background"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/clarity_hint"
            android:textColor="@color/on_background_muted"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="112dp"
                android:layout_height="wrap_content"
                android:text="@string/clarity_strength"
                android:textColor="@color/on_background"
                android:textSize="16sp" />

            <SeekBar
                android:id="@+id/clarityStrengthSeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="10" />

            <TextView
                android:id="@+id/clarityStrengthValue"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@color/on_background"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="112dp"
                android:layout_height="wrap_content"
                android:text="@string/clarity_threshold"
                android:textColor="@color/on_background"
                android:textSize="16sp" />

            <SeekBar
                android:id="@+id/clarityThresholdSeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="30" />

            <TextView
                android:id="@+id/clarityThresholdValue"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@color/on_background"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/limiter_title"
            android:textColor="@color/on_background"
            android:textSize="20sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/limiter_hint"
            android:textColor="@color/on_background_muted"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="112dp"
                android:layout_height="wrap_content"
                android:text="@string/limiter_ceiling"
                android:textColor="@color/on_background"
                android:textSize="16sp" />

            <SeekBar
                android:id="@+id/limiterSeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="21" />

            <TextView
                android:id="@+id/limiterValue"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@color/on_background"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
