<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:id="@+id/disclaimerGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/disclaimer_title"
                android:textColor="@color/on_background"
                android:textSize="28sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/disclaimer_body"
                android:textColor="@color/on_background"
                android:textSize="18sp" />

            <Button
                android:id="@+id/acceptButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:minHeight="64dp"
                android:text="@string/disclaimer_accept"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/mainGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/on_background"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/statusView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/on_background"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/routeView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/on_background_muted"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/micLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/mic_label"
                android:textColor="@color/on_background"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/phoneMicButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/mic_button_bg"
                    android:minHeight="64dp"
                    android:text="@string/mic_phone"
                    android:textColor="@color/mic_button_text"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/headsetMicButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/mic_button_bg"
                    android:minHeight="64dp"
                    android:text="@string/mic_headset"
                    android:textColor="@color/mic_button_text"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/micHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/on_background_muted"
                android:textSize="16sp" />

            <Button
                android:id="@+id/toggleButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:minHeight="64dp"
                android:text="@string/action_start"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/latencyView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/on_background_muted"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/permanent_disclaimer"
                android:textColor="@color/on_background"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
